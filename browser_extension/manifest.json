{
  "manifest_version": 3,
  "name": "Джарвис — браузер",
  "short_name": "Джарвис",
  "version": "1.0.0",
  "description": "Связь голосового ассистента Джарвис с браузером: ищет, читает и сравнивает на сайтах в отдельном окне. Работает только с Джарвисом на этом компьютере (127.0.0.1).",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {"service_worker": "background.js"},
  "permissions": ["scripting", "tabs", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Джарвис: нет связи",
    "default_icon": {"16": "icons/off-16.png", "32": "icons/off-32.png", "48": "icons/off-48.png", "128": "icons/off-128.png"}
  },
  "icons": {"16": "icons/idle-16.png", "32": "icons/idle-32.png", "48": "icons/idle-48.png", "128": "icons/idle-128.png"}
}
